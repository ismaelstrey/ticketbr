generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  TODO
  DOING
  PAUSED
  DONE
}

enum TicketPriority {
  HIGH
  MEDIUM
  NONE
}

enum TicketEventType {
  CREATED
  STATUS_CHANGED
  PAUSED
  COMMENT
  NOTE
  ASSIGNED
  SLA_UPDATED
  UPDATED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum NotificationType {
  TICKET_STATUS_CHANGED
  TICKET_COMMENT
  TICKET_ASSIGNED
  SLA_WARNING
  SLA_BREACHED
}

// Inventário de equipamentos e cofre de credenciais
enum EquipmentType {
  SWITCH
  ROUTER
  FIREWALL
  SERVER
  // Host de virtualização (Proxmox VE, ESXi, vCenter...)
  HYPERVISOR
  VM
  // Container (Docker/LXC) executado dentro de uma VM ou host
  CONTAINER
  COMPUTER
  PRINTER
  ACCESS_POINT
  OTHER
}

// Plataforma de virtualização do host
enum VirtualizationPlatform {
  PROXMOX_VE
  VMWARE_ESXI
  VMWARE_VCENTER
  MICROSOFT_HYPERV
  XCP_NG
  KVM
  OTHER
}

// Controlador de gerenciamento fora de banda do servidor físico
enum ManagementController {
  NONE
  ILO
  IDRAC
  IPMI
  ILO_AND_IDRAC
  OTHER
}

enum EquipmentStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
  RETIRED
}

enum CredentialProtocol {
  SSH
  TELNET
  HTTP
  HTTPS
  RDP
  SNMP
  OTHER
}

// Define quem, por padrão, consegue revelar a senha de uma credencial
enum CredentialAccessPolicy {
  OWNER_AND_ADMINS
  STAFF
  CUSTOM
}

// Nível de acesso concedido a um sujeito no cofre
enum CredentialAccessLevel {
  VIEW
  REVEAL
}

// Tipo de sujeito que recebe uma concessão de acesso à credencial
enum AccessSubjectType {
  USER
  GROUP
  ROLE
}

// Existing User model - keeping for backward compatibility or future migration
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   @default("default_hash")
  role      Role     @default(AGENT)
  whatsappId     String?  @unique
  remoteJid      String?  @db.Text
  pushName       String?
  profilePicUrl  String?  @db.Text
  instanceId     String?
  funcionario    Funcionario?
  events    TicketEvent[]
  createdTickets Ticket[] @relation("TicketCreatedBy")
  notifications Notification[]
  passwordResets PasswordResetToken[]

  createdTasks Task[] @relation("TaskCreatedBy")
  assignedTasks Task[] @relation("TaskAssignee")
  createdTaskAttachments TaskAttachment[] @relation("TaskAttachmentCreatedBy")
  taskComments TaskComment[] @relation("TaskCommentAuthor")

  ownedProjects Project[] @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  projectExports ProjectExportAudit[]
  ownedCredentials EquipmentCredential[] @relation("CredentialOwner")
  userGroups UserGroupMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppContact {
  id            String   @id
  funcionarios   Funcionario[]
  remoteJid     String   @map("remote_jid") @db.Text
  pushName      String?  @map("push_name")
  profilePicUrl String?  @map("profile_pic_url") @db.Text
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")
  instanceId    String?  @map("instance_id")
  syncedAt      DateTime @default(now()) @map("synced_at")

  @@index([remoteJid])
  @@index([instanceId])
  @@map("whatsapp_contacts")
}

model Solicitante {
  id               String   @id @default(cuid())
  razao_social     String   @db.VarChar(255)
  nome_fantasia    String   @db.VarChar(255)
  cnpj             String   @unique @db.VarChar(14)
  email            String   @db.VarChar(255)
  telefone         String   @db.VarChar(20)
  endereco_completo String   @db.Text
  data_cadastro    DateTime @default(now())
  status           Boolean  @default(true)
  
  // Audit fields
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  created_by       String?
  updated_by       String?
  deleted_at       DateTime?

  funcionarios     Funcionario[]
  tickets          Ticket[]
  equipment        Equipment[]
  sharedSecrets    ClientSharedSecret[]

  @@index([cnpj])
  @@index([email])
  @@index([telefone])
}

model Funcionario {
  id             String      @id @default(cuid())
  solicitante_id String
  solicitante    Solicitante @relation(fields: [solicitante_id], references: [id], onDelete: Restrict)

  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  nome           String      @db.VarChar(255)
  email          String?     @db.VarChar(255)
  telefone       String      @db.VarChar(20)

  whatsappId       String?          @unique
  remoteJid        String?          @db.Text
  pushName         String?
  profilePicUrl    String?          @db.Text
  instanceId       String?
  whatsappContactId String?         @map("whatsapp_contact_id")
  whatsappContact  WhatsAppContact? @relation(fields: [whatsappContactId], references: [id], onDelete: SetNull)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  isAdmin        Boolean     @default(false) @map("is_admin")

  @@unique([solicitante_id, telefone])
  @@index([solicitante_id])
  @@index([telefone])
  @@index([whatsappContactId])
}

model AuditLog {
  id            String   @id @default(cuid())
  solicitanteId String?  @map("solicitante_id")
  actorUserId   String?  @map("actor_user_id")
  action        String
  entity        String
  entityId      String?  @map("entity_id")
  metadata      Json?    @map("metadata")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([solicitanteId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Tipo_Ticket {
  id                String   @id @default(cuid())
  nome              String   @unique @db.VarChar(100)
  descricao         String   @db.Text
  sla_horas         Int
  prioridade_default String   @db.VarChar(20)
  status            Boolean  @default(true)
  
  // Audit fields
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  created_by        String?
  updated_by        String?
  deleted_at        DateTime?

  categorias        Categoria_Ticket[]
  tickets           Ticket[]
}

model Categoria_Ticket {
  id             String      @id @default(cuid())
  tipo_ticket_id String
  tipo_ticket    Tipo_Ticket @relation(fields: [tipo_ticket_id], references: [id], onDelete: Restrict)
  nome           String      @db.VarChar(100)
  descricao      String      @db.Text
  status         Boolean     @default(true)
  
  // Audit fields
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  created_by     String?
  updated_by     String?
  deleted_at     DateTime?

  tickets        Ticket[]

  @@unique([tipo_ticket_id, nome])
}

model Mesa_Trabalho {
  id             String    @id @default(cuid())
  nome           String    @db.VarChar(100)
  localizacao    String    @db.VarChar(255)
  capacidade     Int
  responsavel_id String?
  responsavel    Operador? @relation("MesaResponsavel", fields: [responsavel_id], references: [id], onDelete: SetNull)
  status         Boolean   @default(true)
  tipo           String    @db.VarChar(50)
  
  // Audit fields
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  created_by     String?
  updated_by     String?
  deleted_at     DateTime?

  operadores     Operador[] @relation("MesaOperadores")
  tickets        Ticket[]
}

model Operador {
  id               String   @id @default(cuid())
  nome             String   @db.VarChar(255)
  email            String   @unique @db.VarChar(255)
  senha_hash       String   @db.VarChar(255)
  matricula        String   @unique @db.VarChar(50)
  perfil           String   @db.VarChar(50)
  mesa_trabalho_id String?
  mesa_trabalho    Mesa_Trabalho? @relation("MesaOperadores", fields: [mesa_trabalho_id], references: [id], onDelete: SetNull)
  is_tecnico       Boolean  @default(true)
  is_active        Boolean  @default(true)
  ultimo_acesso    DateTime?
  especialidade    String?  @db.VarChar(100)
  
  // Audit fields
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  created_by       String?
  updated_by       String?
  deleted_at       DateTime?

  mesas_responsaveis Mesa_Trabalho[] @relation("MesaResponsavel")
  tickets            Ticket[]
}

model Ticket {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement())
  
  // New relationships
  solicitante_id String?
  solicitante    Solicitante? @relation(fields: [solicitante_id], references: [id], onDelete: Restrict)
  
  tipo_ticket_id String?
  tipo_ticket    Tipo_Ticket? @relation(fields: [tipo_ticket_id], references: [id], onDelete: Restrict)
  
  categoria_id   String?
  categoria      Categoria_Ticket? @relation(fields: [categoria_id], references: [id], onDelete: Restrict)
  
  mesa_trabalho_id String?
  mesa_trabalho_rel Mesa_Trabalho? @relation(fields: [mesa_trabalho_id], references: [id], onDelete: Restrict)
  
  operador_id    String?
  operador_rel   Operador? @relation(fields: [operador_id], references: [id], onDelete: Restrict)

  subject       String
  description   String?
  status        TicketStatus   @default(TODO)
  priority      TicketPriority @default(NONE)

  createdByUserId String?
  createdByUser   User?        @relation("TicketCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  
  contact       String?
  responseSlaAt DateTime?
  solutionSlaAt DateTime?
  pausedReason  String?
  pauseSla      Boolean        @default(false)
  pausedStartedAt DateTime?
  pausedTotalSeconds Int       @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Audit fields
  created_by    String?
  updated_by    String?
  deleted_at    DateTime?

  events        TicketEvent[]
  chatConversations ChatConversation[]
  notifications Notification[]

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([solicitante_id])
  @@index([createdByUserId])
}

model TicketEvent {
  id          String          @id @default(cuid())
  ticketId    String
  ticket      Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type        TicketEventType
  title       String
  description String?
  fromStatus  TicketStatus?
  toStatus    TicketStatus?
  pauseReason String?
  metadata    Json?
  
  // Legacy string field
  author      String?
  
  // Relation to User model
  authorId    String?
  authorUser  User?           @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime        @default(now())

  @@index([ticketId, createdAt])
  @@index([type])
}


model ChatConversation {
  id             String   @id @default(cuid())
  contactId      String
  contactName    String
  channel        String
  conversationId String
  ticketId       String?
  ticket         Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  messages       Json
  finalized      Boolean  @default(false)
  closedAt       DateTime @default(now())
  nextStartedAt  DateTime?
  createdBy      String?

  @@index([contactId, channel, finalized, closedAt])
  @@index([contactId, channel, nextStartedAt])
  @@index([ticketId])
}

model Conversation {
  id              String    @id @default(cuid()) // conversation_id
  waChatId        String    @unique @map("wa_chat_id") // JID do WhatsApp
  instance        String?
  status          String    @default("open") // open, closed
  botActive       Boolean   @default(true) @map("bot_active")
  humanActive     Boolean   @default(false) @map("human_active")
  assignedTo      String?   @map("assigned_to") // userId
  lastMessageAt   DateTime? @map("last_message_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  messages        Message[]

  @@map("conversations")
}

model Message {
  id              String    @id @default(cuid())
  waMessageId     String?   @unique @map("wa_message_id")
  conversationId  String    @map("conversation_id")
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  direction       String    // in, out
  type            String    // text, image, audio, etc.
  body            String?   @db.Text // text or caption
  mediaUrl        String?   @map("media_url")
  mimetype        String?
  status          String    @default("sent") // sent, delivered, read
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("messages")
}

model Task {
  id           String       @id @default(cuid())
  title        String       @db.VarChar(180)
  description  String?      @db.Text
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(PENDING)
  sortOrder    Float        @default(0) @map("sort_order")
  dueAt        DateTime?    @map("due_at")
  completedAt  DateTime?    @map("completed_at")

  assigneeId   String?      @map("assignee_id")
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById  String       @map("created_by_id")
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subtasks     TaskSubtask[]
  attachments  TaskAttachment[]
  ticketLinks  TaskTicketLink[]
  comments     TaskComment[]

  @@index([status, sortOrder])
  @@index([dueAt])
  @@index([assigneeId])
  @@index([createdById])
}

model TaskSubtask {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(220)
  isDone    Boolean  @default(false) @map("is_done")
  sortOrder Float    @default(0) @map("sort_order")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, sortOrder])
}

model TaskAttachment {
  id          String   @id @default(cuid())
  taskId      String   @map("task_id")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName    String   @map("file_name")
  mimeType    String?  @map("mime_type")
  fileSize    Int?     @map("file_size")
  data        Bytes
  createdById String   @map("created_by_id")
  createdBy   User     @relation("TaskAttachmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([taskId])
}

model TaskTicketLink {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ticketId  String   @map("ticket_id")
  createdAt DateTime @default(now())

  @@unique([taskId, ticketId])
  @@index([ticketId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model Project {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(180)
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)

  ownerUserId String        @map("owner_user_id")
  ownerUser   User          @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  startDate   DateTime?     @db.Date @map("start_date")
  endDate     DateTime?     @db.Date @map("end_date")
  archivedAt  DateTime?     @map("archived_at")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  members     ProjectMember[]
  exports     ProjectExportAudit[]

  @@index([status, createdAt])
  @@index([ownerUserId, createdAt])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@map("project_members")
}

model ProjectExportAudit {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String?  @map("project_id")
  format    String
  filters   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("project_export_audit")
}

model Notification {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId       String?          @map("ticket_id")
  ticket         Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  solicitante_id String?          @map("solicitante_id")
  tipo           NotificationType
  title          String
  body           String?          @db.Text
  link           String?
  metadata       Json?
  // Evita notificações duplicadas em varreduras periódicas (ex.: SLA)
  dedupeKey      String?          @unique @map("dedupe_key")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([ticketId])
  @@map("notifications")
}

// Snapshot diário de KPIs gerenciais (pré-agregação para relatórios e tendências)
model KpiSnapshot {
  id                         String   @id @default(cuid())
  snapshotDate               DateTime @unique @map("snapshot_date") @db.Date
  openTotal                  Int      @default(0) @map("open_total")
  doneTotal                  Int      @default(0) @map("done_total")
  overdueTotal               Int      @default(0) @map("overdue_total")
  slaWarningTotal            Int      @default(0) @map("sla_warning_total")
  avgResolutionHours         Float?   @map("avg_resolution_hours")
  firstContactResolutionRate Float?   @map("first_contact_resolution_rate")
  details                    Json?
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("kpi_snapshots")
}

// Registro persistido das chamadas externas recebidas nos endpoints públicos de webhook
model WebhookRequestLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  method    String   @db.VarChar(10)
  path      String   @db.VarChar(255)
  route     String   @db.VarChar(80)
  source    String   @db.VarChar(40)
  status    Int
  ok        Boolean
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(255) @map("user_agent")
  payload   Json?
  headers   Json     @default("{}")

  @@index([createdAt])
  @@index([route, createdAt])
  @@index([source, createdAt])
  @@index([status, createdAt])
  @@map("webhook_request_logs")
}

// Tokens de recuperação de senha do portal do cliente (armazenados como hash)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================
// Inventário de equipamentos
// ============================================================
model Equipment {
  id            String          @id @default(cuid())
  code          String?         @unique @db.VarChar(60) // patrimônio/etiqueta
  name          String          @db.VarChar(180)
  type          EquipmentType
  status        EquipmentStatus @default(ACTIVE)
  brand         String?         @db.VarChar(120)
  model         String?         @db.VarChar(120)
  serialNumber  String?         @map("serial_number") @db.VarChar(120)
  hostname      String?         @db.VarChar(180)
  ipAddress     String?         @map("ip_address") @db.VarChar(64)
  macAddress    String?         @map("mac_address") @db.VarChar(64)
  location      String?         @db.VarChar(180)
  func          String?         @db.VarChar(180) // função do equipamento
  description   String?         @db.Text

  // --- Hierarquia de infraestrutura: host -> VM -> container ---
  parentId      String?         @map("parent_id")
  parent        Equipment?      @relation("EquipmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Equipment[]     @relation("EquipmentHierarchy")

  // --- Virtualização e gerenciamento fora de banda ---
  virtualizationPlatform VirtualizationPlatform? @map("virtualization_platform")
  managementController   ManagementController?   @map("management_controller")
  managementIp           String?                 @map("management_ip") @db.VarChar(64)
  managementUrl          String?                 @map("management_url")
  url                    String? // link de acesso web do recurso
  vmid                   Int? // ID da VM/container dentro do hypervisor
  guestOs                String?                 @map("guest_os") @db.VarChar(120)
  cpuCores               Int?                    @map("cpu_cores")
  memoryMb               Int?                    @map("memory_mb")
  diskGb                 Int?                    @map("disk_gb")
  tags                   String[]                @default([])

  solicitanteId String?         @map("solicitante_id")
  solicitante   Solicitante?    @relation(fields: [solicitanteId], references: [id], onDelete: SetNull)

  credentials   EquipmentCredential[]

  // Audit fields
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  created_by    String?
  updated_by    String?
  deleted_at    DateTime?

  @@index([type, status])
  @@index([ipAddress])
  @@index([solicitanteId])
  @@index([parentId])
  @@index([solicitanteId, type])
  @@map("equipment")
}

// ============================================================
// Cofre de credenciais (senhas cifradas)
// ============================================================
model EquipmentCredential {
  id            String                 @id @default(cuid())
  // Nulo permite credenciais avulsas (sem equipamento vinculado)
  equipmentId   String?                @map("equipment_id")
  equipment     Equipment?             @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  label         String                 @db.VarChar(120) // ex.: "admin web", "console", "SSH"
  protocol      CredentialProtocol     @default(SSH)
  port          Int?
  username      String?                @db.VarChar(180)
  // Link de acesso direto do recurso (ex.: https://10.0.0.5:8006)
  url           String?
  // Segredo cifrado (AES-256-GCM) — nunca armazenado em texto puro.
  // Nulo quando a credencial usa a senha padrão compartilhada do cliente.
  secret        Json?
  notes         String?                @db.Text

  // Senha padrão do cliente (quando definida, substitui a senha própria da credencial)
  sharedSecretId String?               @map("shared_secret_id")
  sharedSecret   ClientSharedSecret?   @relation(fields: [sharedSecretId], references: [id], onDelete: SetNull)

  accessPolicy  CredentialAccessPolicy @default(OWNER_AND_ADMINS) @map("access_policy")
  ownerUserId   String?                @map("owner_user_id")
  owner         User?                  @relation("CredentialOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  lastRotatedAt DateTime?              @map("last_rotated_at")

  // Audit fields
  created_at    DateTime               @default(now())
  updated_at    DateTime               @updatedAt
  created_by    String?
  updated_by    String?
  deleted_at    DateTime?

  grants        CredentialAccessGrant[]

  @@index([equipmentId])
  @@index([ownerUserId])
  @@index([sharedSecretId])
  @@map("equipment_credentials")
}

// ============================================================
// Senhas padrão por cliente (compartilhadas entre equipamentos)
// ============================================================
model ClientSharedSecret {
  id            String      @id @default(cuid())
  solicitanteId String      @map("solicitante_id")
  solicitante   Solicitante @relation(fields: [solicitanteId], references: [id], onDelete: Cascade)

  label         String      @db.VarChar(120) // ex.: "Senha padrão roteadores"
  // Segredo cifrado (AES-256-GCM) — nunca armazenado em texto puro
  secret        Json
  notes         String?     @db.Text

  // Audit fields
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  created_by    String?
  updated_by    String?
  deleted_at    DateTime?

  credentials   EquipmentCredential[]

  @@index([solicitanteId])
  @@map("client_shared_secrets")
}

// Concessões de acesso por credencial (usuário específico, grupo ou papel)
model CredentialAccessGrant {
  id           String                @id @default(cuid())
  credentialId String                @map("credential_id")
  credential   EquipmentCredential   @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  subjectType  AccessSubjectType     @map("subject_type")
  subjectId    String?               @map("subject_id") // userId ou groupId (nulo quando ROLE)
  role         Role?                 // usado quando subjectType = ROLE
  level        CredentialAccessLevel @default(REVEAL)

  createdAt    DateTime              @default(now()) @map("created_at")
  createdById  String?               @map("created_by_id")

  @@index([credentialId])
  @@index([subjectType, subjectId])
  @@map("credential_access_grants")
}

// ============================================================
// Grupos de usuários (para conceder acesso em massa)
// ============================================================
model UserGroup {
  id          String            @id @default(cuid())
  name        String            @unique @db.VarChar(120)
  description String?           @db.Text

  // Audit fields
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  created_by  String?
  updated_by  String?
  deleted_at  DateTime?

  members     UserGroupMember[]

  @@map("user_groups")
}

model UserGroupMember {
  id        String    @id @default(cuid())
  groupId   String    @map("group_id")
  userId    String    @map("user_id")
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([groupId, userId])
  @@index([userId])
  @@map("user_group_members")
}
