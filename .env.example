DATABASE_URL="postgresql://user:password@localhost:5432/ticketbr"
JWT_SECRET="replace-with-a-strong-random-secret"

# URL base usada nos links de notificação (email) enviados aos usuários
APP_BASE_URL="http://localhost:3000"

# SMTP para envio de emails de notificação (host + remetente habilitam o envio)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TicketBR <no-reply@example.com>"

# Janela (em horas) para o alerta de SLA próximo do vencimento
SLA_WARNING_HOURS="4"

# Segredo enviado pelo scheduler (Vercel Cron) para o endpoint /api/cron/sla-scan
CRON_SECRET="replace-with-a-random-cron-secret"

# Optional: distributed rate limiting for production (recommended)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"
RATE_LIMIT_KEY_PREFIX="ticketbr:rate-limit"
